# Alba funciona sin estas variables: usa PostgreSQL en memoria y no envía correo.
# Para Postgres real (incluido Supabase Postgres), definí la URL. No hace falta el cliente de Supabase Auth.

DATABASE_URL=postgres://usuario:clave@localhost:5432/alba
DATABASE_URL_UNPOOLED=postgres://usuario:clave@localhost:5432/alba

# Correo con Resend. Si faltan, la app muestra el modo desarrollo y no dice que envió un email.
RESEND_API_KEY=
EMAIL_FROM=Alba <turnos@tudominio.com>

# Protege POST /api/cron/recordatorios. Sin este valor el endpoint responde 503.
CRON_SECRET=

# Origen público, sin barra final. Si falta, no se arma un enlace de recuperación.
APP_ORIGIN=http://127.0.0.1:3847

# Las cuentas de ejemplo no inician sesión. Solo false vuelve a permitirlas.
DISABLE_DEMO_LOGINS=true
